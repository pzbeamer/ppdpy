+# Portable build for CavityDetection (Linux and macOS, GCC or Clang).
+# Dependencies: OpenVDB, TBB, Boost (headers; timer), CGAL (header-only, needs GMP/MPFR).
+# Easiest on macOS: the conda environment in environment.yml (see SETUP_MACOS.md),
+# then:  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j
+# The original Linux file is kept as CMakeLists.linux-original.txt.
+cmake_minimum_required(VERSION 3.16)
+project(CavityDetection CXX)
 
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
+  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
+endif()
 
+# Prefer an active conda env, then Homebrew, for every find_* call.
+if(DEFINED ENV{CONDA_PREFIX})
+  list(PREPEND CMAKE_PREFIX_PATH "$ENV{CONDA_PREFIX}")
+endif()
+if(APPLE)
+  foreach(p /opt/homebrew /usr/local)
+    if(EXISTS "${p}")
+      list(APPEND CMAKE_PREFIX_PATH "${p}")
+    endif()
+  endforeach()
+endif()
+list(APPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake_modules")
+
+# ---- OpenVDB: its CMake config if installed, else the bundled simple finder
+#      (cmake_modules/FindOpenVDB.cmake: header + libopenvdb). OpenVDB's own
+#      FindOpenVDB.cmake is avoided on purpose: it insists on extra Boost components.
+find_package(OpenVDB CONFIG QUIET)
+if(NOT TARGET OpenVDB::openvdb)
+  find_package(OpenVDB MODULE REQUIRED)
+endif()
+
+# ---- TBB (oneTBB ships TBBConfig.cmake)
+find_package(TBB CONFIG QUIET)
+if(NOT TARGET TBB::tbb)
+  find_package(TBB REQUIRED)       # bundled cmake_modules/FindTBB.cmake
+endif()
+
+# ---- Boost: only headers are needed (boost/timer.hpp, deprecated API);
+#      boost_system is header-only since 1.69 and its stub library is gone in 1.89.
+find_package(Boost REQUIRED)
+add_compile_definitions(BOOST_TIMER_ENABLE_DEPRECATED)
+
+# ---- CGAL (header-only since 5.0)
+find_package(CGAL REQUIRED)
+
+# ---- OpenMP is optional (Apple clang has none unless libomp is installed)
+find_package(OpenMP)
+
+add_executable(CavityDetection main.cpp CavityDetection.cpp CavityDetection.h nanoflann.hpp FlannUtils.h)
+target_include_directories(CavityDetection PRIVATE ${CMAKE_SOURCE_DIR})
+
+if(TARGET OpenVDB::openvdb)
+  target_link_libraries(CavityDetection PRIVATE OpenVDB::openvdb)
+else()
+  # old bundled finder: plain library; add OpenVDB's Half/Imath dependency by hand
+  target_include_directories(CavityDetection PRIVATE ${OPENVDB_INCLUDE_DIRS} ${OpenVDB_INCLUDE_DIRS})
+  target_link_libraries(CavityDetection PRIVATE ${OPENVDB_LIBRARIES} ${OpenVDB_LIBRARIES})
+  # OpenVDB's half type comes from Imath (OpenVDB >= 9) or IlmBase Half (older)
+  find_package(Imath CONFIG QUIET)
+  if(TARGET Imath::Imath)
+    target_link_libraries(CavityDetection PRIVATE Imath::Imath)
+  else()
+    find_library(HALF_LIBRARY NAMES Half Half-2_5 Half-2_4)
+    if(HALF_LIBRARY)
+      target_link_libraries(CavityDetection PRIVATE ${HALF_LIBRARY})
+    endif()
+  endif()
+endif()
+if(TARGET TBB::tbb)
+  target_link_libraries(CavityDetection PRIVATE TBB::tbb)
+else()
+  target_include_directories(CavityDetection PRIVATE ${TBB_INCLUDE_DIRS})
+  target_link_libraries(CavityDetection PRIVATE ${TBB_LIBRARIES})
+endif()
+if(TARGET Boost::headers)
+  target_link_libraries(CavityDetection PRIVATE Boost::headers)
+else()
+  target_include_directories(CavityDetection PRIVATE ${Boost_INCLUDE_DIRS})
+endif()
+if(TARGET CGAL::CGAL)
+  target_link_libraries(CavityDetection PRIVATE CGAL::CGAL)
+elseif(CGAL_USE_FILE)
+  include(${CGAL_USE_FILE})
+  target_link_libraries(CavityDetection PRIVATE ${CGAL_LIBRARIES} ${CGAL_3RD_PARTY_LIBRARIES})
+endif()
+if(OpenMP_CXX_FOUND)
+  target_link_libraries(CavityDetection PRIVATE OpenMP::OpenMP_CXX)
+endif()
+
+find_package(Threads REQUIRED)
+target_link_libraries(CavityDetection PRIVATE Threads::Threads)
+
+# GCC 14 needs these for the 2018 code; Clang does not understand them.
+if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+  target_compile_options(CavityDetection PRIVATE -fpermissive -Wno-template-body -Werror=return-type)
+elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  # -ffp-contract=off: no fused multiply-add, so Apple-silicon results match x86 Linux
+  target_compile_options(CavityDetection PRIVATE -Wno-deprecated-declarations -Werror=return-type
+                         -ffp-contract=off)
+endif()
